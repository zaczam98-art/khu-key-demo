# 서버 전용 값입니다. .env.local로 복사해서 채우고, .env.local은 절대 커밋하지 않습니다.

# ChatKHU API 키. 베이즈 좌측 사이드바 하단 "API Gateway" > "API 키" 탭 > "API 키 생성"
CHATKHU_API_KEY=
CHATKHU_BASE=https://factchat-cloud.mindlogic.ai/v1/gateway

# 스튜디오 챗봇 id 4개. 스튜디오 대시보드 URL /dashboard/studio/[id] 의 숫자.
# 챗봇 상세 > 공유 > API 탭 > "API로 이 챗봇 호출하기"를 켜야 합니다.
# 비우면 키만으로 일반 모델(CHATKHU_MODEL)에 server/prompts/ 의 지시문을 붙여 호출하고, 키도 비우면 체험 모드로 돌아갑니다.
CHATKHU_BOT_EXPLORE=      # 직무 탐색
CHATKHU_BOT_INTERVIEW=    # 경험 인터뷰(경험 카드)
CHATKHU_BOT_ESSAY=        # 자소서 (지금은 구조화 출력만 써서 비워도 됩니다)
CHATKHU_BOT_MOCK=         # 면접관

# 구조화 출력(분석·카드·공고·초안·채점)과, 챗봇 id가 없을 때의 대화에 쓰는 모델
CHATKHU_MODEL=claude-sonnet-5-5
# 자소서 초안·전체 수정(긴 출력)에 쓰는 모델. Haiku 가 10초 안팎으로 빠릅니다(Sonnet 은 40초 안팎).
CHATKHU_ESSAY_MODEL=claude-haiku-5-5
DAILY_CREDIT_CAP=550

# 선택: Vercel KV. 비우면 서버 인스턴스 메모리로 일일 사용량과 푸시 구독을 셉니다.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# 선택: 웹 푸시. `npx web-push generate-vapid-keys` 로 만듭니다. 비우면 이 기기 알림만 됩니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_SECRET=              # POST /api/push {send:true} 를 부를 때 x-push-secret 헤더 값
VITE_VAPID_PUBLIC_KEY=    # 브라우저가 구독할 때 쓰는 같은 공개키 (VITE_ 접두사라 번들에 포함됨)

# 빌드 base 경로. GitHub Pages 프로젝트 사이트는 /khu-key-demo/, Vercel은 비워 둡니다.
VITE_BASE=
